# Relative so it works both on localhost and through a tunnel (Vite proxies /api to the backend).
# In production, set it to the deployed API, e.g. https://api.example.com/api
VITE_API_URL=/api
# OAuth 2.0 Client ID from Google Cloud Console (same value as GOOGLE_CLIENT_ID in backend/.env).
VITE_GOOGLE_CLIENT_ID=
# Video consultations show "Coming soon" everywhere until this is true (after the video call is tested).
VITE_VIDEO_CONSULTATIONS=false
