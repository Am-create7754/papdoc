PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/healthify
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be 32+ random characters and different from each other — the server refuses placeholders in production.
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
# Set to the number of reverse proxies in front of the API in production (usually 1); leave 0 locally.
TRUST_PROXY=0
# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console. Must match VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
RAZORPAY_KEY_ID=changeme_razorpay_test_key_id
RAZORPAY_KEY_SECRET=changeme_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=changeme_razorpay_webhook_secret
META_WHATSAPP_ACCESS_TOKEN=changeme_meta_whatsapp_access_token
META_WHATSAPP_PHONE_NUMBER_ID=changeme_meta_phone_number_id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=changeme_meta_business_account_id
META_APP_SECRET=changeme_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=changeme_meta_webhook_verify_token
META_GRAPH_API_VERSION=v21.0
DOCTOR_WHATSAPP_NUMBER=+91XXXXXXXXXX
META_WHATSAPP_CONSULTATION_TEMPLATE=new_consultation_alert
META_WHATSAPP_VIDEO_ALERT_TEMPLATE=video_consultation_alert
META_WHATSAPP_PRIORITY_ALERT_TEMPLATE=priority_consultation_alert
META_WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Set to true only after new_consultation_alert and priority_consultation_alert have an IMAGE header
# in Meta: alerts then carry the patient's first photo (or a default "No photo attached" image).
META_WHATSAPP_IMAGE_HEADER=false
# Daily (daily.co) video calls: dashboard.daily.co → Developers → API key.
DAILY_API_KEY=changeme_daily_api_key
VIDEO_MAX_DAILY_CONSULTATIONS=10
VIDEO_DEFAULT_SESSION_MINUTES=10
VIDEO_DOCTOR_JOIN_GRACE_MINUTES=3
VIDEO_PATIENT_JOIN_TIMEOUT_MINUTES=5
